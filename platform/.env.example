# Public URLs
APP_ORIGIN=https://monitc.talhacan.com
ADMIN_ORIGIN=https://monitcap.talhacan.com
API_ORIGIN=https://monitc-api.talhacan.com

# PostgreSQL + pgvector
DATABASE_URL=postgresql://monitc:change-me@postgres:5432/monitc

# Redis Cluster
REDIS_MODE=cluster
REDIS_NODES=redis-0.redis-headless:6379,redis-1.redis-headless:6379,redis-2.redis-headless:6379
REDIS_PASSWORD=change-me

# Ed25519 JWT key pair, PKCS8/SPKI encoded and then base64 encoded.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_KEY_ID=monitc-2026-01
JWT_ISSUER=https://monitc-api.talhacan.com
JWT_AUDIENCE=monitc-platform
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# Libsodium X25519 sealed-box key pair, raw bytes encoded as base64.
VAULT_PUBLIC_KEY_B64=
VAULT_PRIVATE_KEY_B64=
VAULT_KEY_ID=vault-2026-01

# Application-layer AES-256-GCM PII encryption and a separate HMAC blind-index key.
PII_ENCRYPTION_KEY_B64=
PII_INDEX_KEY_B64=

# Optional password pepper stored outside PostgreSQL.
PASSWORD_PEPPER=

# Release storage mounted by Kubernetes.
RELEASES_PATH=/var/lib/monitc/releases

# First admin is created idempotently during API startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Runtime
PORT=8080
LOG_LEVEL=info
WORKER_POLL_SECONDS=30
# Leave blank for a host-only refresh cookie on the API origin.
COOKIE_DOMAIN=
TRUST_PROXY=true
# Keep false for managed SaaS to prevent private-network SSRF. Self-hosters may opt in.
ALLOW_PRIVATE_TARGETS=false
